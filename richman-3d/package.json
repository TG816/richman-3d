{
  "name": "richman-3d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "大富翁 3D —— 网页版大富翁：Three.js 3D 棋盘 + Socket.IO 多人联机 + 文字/实时语音聊天",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "test": "node --test server/rooms.test.mjs server/game/build.test.mjs && node server/game/engine.test.mjs",
    "start": "node server/index.js",
    "preview": "npm run build && node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
